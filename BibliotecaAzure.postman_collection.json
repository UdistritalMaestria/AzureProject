							"listen": "test",
							"script": {
								"exec": [
									"// Verificar que la respuesta sea exitosa\r",
									"if (pm.response.code === 200) {\r",
									"    const response = pm.response.json();\r",
									"    \r",
									"    // Guardar el ID del libro creado para usar en otros tests\r",
									"    pm.collectionVariables.set(\"libro_id\", response.id);\r",
									"    \r",
									"    console.log(\"Libro creado exitosamente:\");\r",
									"    console.log(\"ID: \" + response.id);\r",
									"    console.log(\"Título: \" + response.titulo);\r",
									"    console.log(\"Autor: \" + response.autor);\r",
									"    console.log(\"ISBN: \" + response.isbn);\r",
									"    console.log(\"Cantidad: \" + response.cantidad);\r",
									"    \r",
									"    // Tests\r",
									"    pm.test(\"Status code is 200\", function () {\r",
									"        pm.response.to.have.status(200);\r",
									"    });\r",
									"    \r",
									"    pm.test(\"Response has libro data\", function () {\r",
									"        pm.expect(response).to.have.property('id');\r",
									"        pm.expect(response).to.have.property('titulo');\r",
									"        pm.expect(response).to.have.property('autor');\r",
									"        pm.expect(response).to.have.property('isbn');\r",
									"        pm.expect(response).to.have.property('cantidad');\r",
									"    });\r",
									"} else {\r",
									"    console.log(\"Error: \" + pm.response.text());\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
